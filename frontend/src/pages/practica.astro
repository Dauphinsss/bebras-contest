---
import Layout from "../layouts/Layout.astro";
import { PracticeCategories } from "../components/practice-categories";

const title = "Desafíos de práctica";
---

<Layout title={title} heading="Desafíos de práctica" backHref="/">
  <main class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-6 py-10 sm:px-8">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Desafíos de práctica
      </h1>
      <p class="text-sm leading-6 text-muted-foreground sm:text-base">
        Elige tu categoría según tu edad y empieza a practicar. No necesitas una
        cuenta para practicar.
      </p>
    </div>

    <div
      class="rounded-lg border bg-secondary/30 px-5 py-4 text-center text-sm"
    >
      ¿Tu maestro te dio un <strong>código</strong> para el desafío oficial?{
        " "
      }
      <a
        href="/entrar"
        class="underline underline-offset-2 hover:text-foreground"
      >
        Entrar con el código
      </a>.
    </div>

    <div class="flex flex-col gap-4">
      <h2 class="text-lg font-semibold">Categorías</h2>
      <PracticeCategories client:only="react" />
    </div>
  </main>
</Layout>
