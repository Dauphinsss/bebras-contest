---
import Layout from "../../layouts/Layout.astro";
import { ContestTasksPage } from "../../components/contest-tasks-page";

const title = "Preguntas del desafío";
---

<Layout title={title} heading={title} backHref="/competencias" requireAuth>
  <main class="mx-auto flex w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex w-full flex-col gap-6">
      <ContestTasksPage client:only="react" />
    </div>
  </main>
</Layout>
