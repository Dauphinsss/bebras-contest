---
import Layout from "../layouts/Layout.astro";
import { PracticesHome } from "../components/practices-home";

const title = "Mis prácticas";
---

<Layout title={title} requireAuth allowMaestro>
  <main class="mx-auto flex w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex w-full flex-col gap-6">
      <PracticesHome client:load />
    </div>
  </main>
</Layout>
