---
interface Props {
  allowMaestro?: boolean;
}

const { allowMaestro = false } = Astro.props;
const protectedPath = Astro.url.pathname;
---

<script is:inline define:vars={{ allowMaestro, protectedPath }}>
  function bebrasAuthGuard() {
    // Las transiciones conservan los listeners de páginas anteriores.
    // Este guard solo corresponde a la página protegida que lo creó.
    if (
      window.location.pathname.replace(/\/+$/, "") !==
      protectedPath.replace(/\/+$/, "")
    )
      return;
    const raw = localStorage.getItem("bebras_user");
    const user = raw ? JSON.parse(raw) : null;
    if (!localStorage.getItem("bebras_token") || !user) {
      window.location.replace("/login");
      return;
    }
    const ok =
      user.role === "admin" || (allowMaestro && user.role === "maestro");
    if (!ok) {
      window.location.replace("/");
      return;
    }
    const approved = (user.status || "approved") === "approved";
    if (!approved && window.location.pathname !== "/perfil") {
      window.location.replace("/perfil");
    }
  }

  bebrasAuthGuard();
  document.addEventListener("astro:page-load", bebrasAuthGuard, { once: true });
</script>
