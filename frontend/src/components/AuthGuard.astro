---
interface Props {
  allowMaestro?: boolean;
}
const { allowMaestro = false } = Astro.props;
---

<span hidden data-auth-guard data-allow-maestro={String(allowMaestro)}></span>

<script>
  import { getToken, getUser, subscribeSession } from "../lib/auth";

  let previousToken = getToken();
  function guard() {
    const marker = document.querySelector<HTMLElement>("[data-auth-guard]");
    if (!marker) return;
    const user = getUser();
    if (!user) {
      window.location.replace("/login");
      return;
    }
    if (
      user.role !== "admin" &&
      !(marker.dataset.allowMaestro === "true" && user.role === "maestro")
    ) {
      window.location.replace("/");
      return;
    }
    if (
      user.status !== "approved" &&
      window.location.pathname.replace(/\/+$/, "") !== "/perfil"
    ) {
      window.location.replace("/perfil");
    }
  }
  guard();
  document.addEventListener("astro:page-load", guard);
  subscribeSession(() => {
    const token = getToken();
    guard();
    if (
      token &&
      previousToken &&
      token !== previousToken &&
      document.querySelector("[data-auth-guard]")
    ) {
      window.location.reload();
    }
    previousToken = token;
  });
</script>
