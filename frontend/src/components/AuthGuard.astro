---
interface Props {
  allowMaestro?: boolean;
}

const { allowMaestro = false } = Astro.props;
---

<script is:inline define:vars={{ allowMaestro }}>
  function bebrasAuthGuard() {
    const raw = localStorage.getItem("bebras_user");
    const user = raw ? JSON.parse(raw) : null;
    if (!localStorage.getItem("bebras_token") || !user) {
      window.location.replace("/login");
      return;
    }
    const ok =
      user.role === "admin" || (allowMaestro && user.role === "maestro");
    if (!ok) {
      window.location.replace("/");
      return;
    }
    const approved = (user.status || "approved") === "approved";
    if (!approved && window.location.pathname !== "/perfil") {
      window.location.replace("/perfil");
    }
  }

  bebrasAuthGuard();
  document.addEventListener("astro:page-load", bebrasAuthGuard);
</script>
