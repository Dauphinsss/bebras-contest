---
interface Props {
  allowMaestro?: boolean;
  registrationRestricted?: boolean;
}
const { allowMaestro = false, registrationRestricted = false } = Astro.props;
---

<span
  hidden
  data-auth-guard
  data-allow-maestro={String(allowMaestro)}
  data-registration-restricted={String(registrationRestricted)}></span>

<script>
  import { getUser, subscribeSession } from "../lib/auth";

  // Firebase renueva el ID Token cada hora: recargar por el token cambiaria la
  // pagina sola. Lo que importa es que sea otra persona la que esta dentro.
  let previousUserId = getUser()?.id ?? null;
  function guard() {
    const marker = document.querySelector<HTMLElement>("[data-auth-guard]");
    if (!marker) return;
    const user = getUser();
    if (marker.dataset.registrationRestricted === "true") {
      const allowed = user?.role === "admin" && user.status === "approved";
      document.documentElement.toggleAttribute(
        "data-registration-blocked",
        !allowed,
      );
      if (!allowed) {
        window.location.replace(user?.role === "maestro" ? "/perfil" : "/");
        return;
      }
    }
    if (!user) {
      window.location.replace("/login");
      return;
    }
    if (
      user.role !== "admin" &&
      !(marker.dataset.allowMaestro === "true" && user.role === "maestro")
    ) {
      window.location.replace("/");
      return;
    }
    if (
      user.status !== "approved" &&
      window.location.pathname.replace(/\/+$/, "") !== "/perfil"
    ) {
      window.location.replace("/perfil");
    }
  }
  guard();
  document.addEventListener("astro:after-swap", guard);
  document.addEventListener("astro:page-load", guard);
  subscribeSession(() => {
    const userId = getUser()?.id ?? null;
    guard();
    if (
      userId &&
      previousUserId &&
      userId !== previousUserId &&
      document.querySelector("[data-auth-guard]")
    ) {
      window.location.reload();
    }
    previousUserId = userId;
  });
</script>
