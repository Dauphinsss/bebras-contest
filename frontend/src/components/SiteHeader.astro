---
interface Props {
  heading?: string;
  backHref?: string;
}

import { UserMenu } from "./user-menu";

const { heading, backHref } = Astro.props;
const pathname = Astro.url.pathname;
const isTasks = pathname.startsWith("/tareas");
const isContests = pathname.startsWith("/competencias");
const isGroups = pathname.startsWith("/grupos");
const isMaestros = pathname.startsWith("/maestros");
const isPractice = pathname.startsWith("/practica");
const hasContextualPracticeBack =
  pathname === "/practica/categoria" || pathname === "/practica/tarea";

const links = [
  { href: "/tareas", label: "Tareas", active: isTasks, role: "admin" },
  { href: "/competencias", label: "Competencias", active: isContests, role: "admin" },
  { href: "/grupos", label: "Grupos", active: isGroups, role: "staff" },
  { href: "/maestros", label: "Maestros", active: isMaestros, role: "admin" },
];
---

<header class="border-b bg-background">
  <div
    class="flex w-full items-center justify-between gap-4 px-4 py-3 sm:px-8 lg:px-12"
  >
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <a href="/" class="shrink-0 text-lg font-semibold tracking-tight">Bebras</a>
      {
        heading && (
          <div class="flex min-w-0 items-center border-l pl-3">
            {backHref ? (
              <a
                href={backHref}
                data-practice-back={hasContextualPracticeBack ? "" : undefined}
                class="group flex min-w-0 items-center gap-2 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
              >
                <span class="sr-only">Volver: </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
                <span
                  class="truncate text-sm font-medium transition-colors group-hover:text-primary"
                >
                  {heading}
                </span>
              </a>
            ) : (
              <span class="truncate text-sm font-medium">{heading}</span>
            )}
          </div>
        )
      }
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/practica"
        class:list={[
          "rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
          isPractice
            ? "bg-primary text-primary-foreground"
            : "text-muted-foreground hover:bg-muted hover:text-foreground",
        ]}
      >
        Desafíos
      </a>
      <nav class="hidden items-center gap-1 lg:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-nav-role={link.role}
              aria-current={link.active ? "page" : undefined}
              class:list={[
                "hidden rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
                link.active
                  ? "bg-primary text-primary-foreground"
                  : "text-muted-foreground hover:bg-muted hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <UserMenu client:only="react" />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const raw = localStorage.getItem("bebras_user");
    const user = raw ? JSON.parse(raw) : null;
    if (!user) return;

    document.querySelectorAll("[data-nav-role]").forEach(function (el) {
      const role = el.getAttribute("data-nav-role");
      const show =
        user.role === "admin"
          ? role === "admin" || role === "staff"
          : user.role === "maestro" && role === "staff";
      if (show) {
        el.classList.remove("hidden");
      }
    });
  })();
</script>

<script>
  const backLink = document.querySelector<HTMLAnchorElement>(
    "[data-practice-back]",
  );

  if (backLink) {
    const params = new URLSearchParams(window.location.search);
    const origin = params.get("from") === "/entrar" ? "/entrar" : "/practica";
    const category = (params.get("nombre") ?? "").trim();

    if (window.location.pathname === "/practica/tarea" && category) {
      const categoryParams = new URLSearchParams({ nombre: category, from: origin });
      backLink.href = `/practica/categoria?${categoryParams.toString()}`;
    } else {
      backLink.href = origin;
    }
  }
</script>
