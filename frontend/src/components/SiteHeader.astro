---
interface Props {
  heading?: string;
  backHref?: string;
}

import { UserMenu } from "./user-menu";
import { MobileNavigation } from "./mobile-navigation";
import { SITE_NAV_ITEMS } from "../lib/site-navigation";

const { heading, backHref } = Astro.props;
const pathname = Astro.url.pathname;
const isPractice = pathname.startsWith("/practica");
const hasContextualPracticeBack =
  pathname === "/practica/categoria" || pathname === "/practica/tarea";

const links = SITE_NAV_ITEMS.filter((item) => item.role !== "public").map(
  (item) => ({
    ...item,
    active: pathname === item.href || pathname.startsWith(`${item.href}/`),
  }),
);
---

<header
  class="border-b bg-background"
  transition:name="app-header"
  transition:animate="none"
>
  <div
    class="flex w-full flex-wrap items-center justify-between gap-x-2 px-4 py-3 sm:px-8 lg:flex-nowrap lg:gap-4 lg:px-12"
  >
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <a href="/" class="shrink-0 text-lg font-semibold tracking-tight"
        >Bebras</a
      >
      {
        heading && (
          <div class="flex min-w-0 items-center border-l pl-3">
            {backHref ? (
              <a
                href={backHref}
                data-practice-back={hasContextualPracticeBack ? "" : undefined}
                class="group flex min-w-0 items-center gap-2 rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
              >
                <span class="sr-only">Volver: </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="size-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
                <span class="truncate text-sm font-medium transition-colors group-hover:text-primary">
                  {heading}
                </span>
              </a>
            ) : (
              <span class="truncate text-sm font-medium">{heading}</span>
            )}
          </div>
        )
      }
    </div>
    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <a
        href="/practica"
        data-nav-active={isPractice ? "" : undefined}
        class:list={[
          "relative rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
          isPractice
            ? "text-primary-foreground"
            : "text-muted-foreground hover:bg-muted hover:text-foreground",
        ]}
      >
        {isPractice && <span class="nav-pill" aria-hidden="true" />}
        <span class="relative" data-nav-label data-nav-key="practica">
          Práctica
        </span>
      </a>
      <nav class="flex items-center gap-1">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-nav-role={link.role}
              data-nav-active={link.active ? "" : undefined}
              aria-current={link.active ? "page" : undefined}
              class:list={[
                "relative hidden rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
                link.active
                  ? "text-primary-foreground"
                  : "text-muted-foreground hover:bg-muted hover:text-foreground",
              ]}
            >
              {link.active && <span class="nav-pill" aria-hidden="true" />}
              <span
                class="relative"
                data-nav-label
                data-nav-key={link.href.replace(/\//g, "")}
              >
                {link.label}
              </span>
            </a>
          ))
        }
      </nav>
    </div>
    <MobileNavigation
      pathname={pathname}
      client:only="react"
      transition:persist="mobile-navigation"
    />
    <UserMenu client:only="react" transition:persist="user-menu" />
  </div>
</header>

<script is:inline>
  function bebrasRevealNav() {
    const raw = localStorage.getItem("bebras_user");
    const user = raw ? JSON.parse(raw) : null;
    if (!user) return;
    if ((user.status || "approved") !== "approved") return;

    document.querySelectorAll("[data-nav-role]").forEach(function (el) {
      const role = el.getAttribute("data-nav-role");
      const show =
        user.role === "admin"
          ? role === "admin" || role === "staff"
          : user.role === "maestro" && role === "staff";
      if (show) {
        el.classList.remove("hidden");
      }
    });
  }

  // Solo los dos rótulos que el pill roza —el que deja y el que ocupa— se
  // capturan aparte para quedar por encima de él. Nombrarlos todos hacía que
  // cada palabra pasara a su propia capa y perdiera el suavizado subpíxel:
  // engordaban todas a la vez durante la transición, incluso las que no
  // intervienen.
  function bebrasLabelMatches(label, path) {
    var anchor = label.closest("a");
    var href = anchor ? anchor.getAttribute("href") : null;
    return Boolean(href) && (path === href || path.indexOf(href + "/") === 0);
  }

  function bebrasNameLabels(paths) {
    document.querySelectorAll("[data-nav-label]").forEach(function (label) {
      var involved = paths.some(function (path) {
        return path && bebrasLabelMatches(label, path);
      });
      label.style.viewTransitionName = involved
        ? "nav-label-" + label.getAttribute("data-nav-key")
        : "";
    });
  }

  // Mientras corre la transición, los rótulos se capturan oscuros: el pill va
  // en camino y uno blanco quedaría invisible sobre el fondo. Al quitar la
  // marca, el rótulo activo pasa a blanco con su propia transición de color,
  // ya con el pill debajo.
  var bebrasNavSwapTimer = 0;
  var bebrasPreviousPath = window.location.pathname;

  function bebrasNavSwapStart() {
    window.clearTimeout(bebrasNavSwapTimer);
    document.documentElement.setAttribute("data-nav-swapping", "");
    bebrasNavSwapTimer = window.setTimeout(function () {
      document.documentElement.removeAttribute("data-nav-swapping");
      bebrasNameLabels([]);
      // 90ms de espera más los 180ms de la transición de color hacen que el
      // rótulo termine de aclararse justo cuando el pill se asienta (~310ms).
      // La curva casi no mueve el color al principio, así que mientras el pill
      // todavía viaja el texto sigue oscuro y legible.
    }, 90);
  }

  document.addEventListener("astro:before-preparation", function (event) {
    bebrasPreviousPath = window.location.pathname;
    var target =
      event && event.to ? new URL(event.to, window.location.href) : null;
    bebrasNameLabels([bebrasPreviousPath, target ? target.pathname : null]);
  });

  bebrasRevealNav();
  // En after-swap todavía se está dentro de la transición de vista: revelar y
  // nombrar aquí deja el pill y los dos rótulos listos en la foto nueva, que es
  // lo que el navegador necesita para deslizarlo. En page-load ya sería tarde.
  document.addEventListener("astro:after-swap", function () {
    bebrasRevealNav();
    bebrasNameLabels([bebrasPreviousPath, window.location.pathname]);
    bebrasNavSwapStart();
  });
  document.addEventListener("astro:page-load", bebrasRevealNav);
</script>

<script>
  function setPracticeBackLink() {
    const backLink = document.querySelector<HTMLAnchorElement>(
      "[data-practice-back]",
    );

    if (!backLink) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    const origin = params.get("from") === "/entrar" ? "/entrar" : "/practica";
    const category = (params.get("nombre") ?? "").trim();

    if (window.location.pathname === "/practica/tarea" && category) {
      const categoryParams = new URLSearchParams({
        nombre: category,
        from: origin,
      });
      backLink.href = `/practica/categoria?${categoryParams.toString()}`;
    } else {
      backLink.href = origin;
    }
  }

  setPracticeBackLink();
  document.addEventListener("astro:page-load", setPracticeBackLink);
</script>
