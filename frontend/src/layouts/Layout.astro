---
import "../styles/global.css";
import { ClientRouter, slide } from "astro:transitions";
import { AppToaster } from "../components/app-toaster";
import AuthGuard from "../components/AuthGuard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  heading?: string;
  backHref?: string;
  requireAuth?: boolean;
  allowMaestro?: boolean;
  enableClientRouting?: boolean;
  deferChrome?: boolean;
}

const {
  title = "Bebras",
  heading,
  backHref,
  requireAuth = false,
  allowMaestro = false,
  enableClientRouting = true,
  deferChrome = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" transition:name="app-root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/castor.png" />
    <title>{title}</title>
    {enableClientRouting && <ClientRouter />}
    {requireAuth && <AuthGuard allowMaestro={allowMaestro} />}
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <SiteHeader heading={heading} backHref={backHref} hidden={deferChrome} />
      <div
        class="flex-1"
        data-page-content
        transition:name="app-content"
        transition:animate={slide({ duration: "220ms" })}
      >
        <slot />
      </div>
      <SiteFooter hidden={deferChrome} />
    </div>
    <AppToaster client:load transition:persist="app-toaster" />
  </body>
</html>
