---
import "../styles/global.css";
import { AppToaster } from "../components/app-toaster";
import AuthGuard from "../components/AuthGuard.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title?: string;
  heading?: string;
  backHref?: string;
  requireAuth?: boolean;
  allowMaestro?: boolean;
}

const {
  title = "Bebras",
  heading,
  backHref,
  requireAuth = false,
  allowMaestro = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/castor.png" />
    <title>{title}</title>
    {requireAuth && <AuthGuard allowMaestro={allowMaestro} />}
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <SiteHeader heading={heading} backHref={backHref} />
      <div class="flex-1">
        <slot />
      </div>
      <SiteFooter />
    </div>
    <AppToaster client:load />
  </body>
</html>
