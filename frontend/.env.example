PUBLIC_API_BASE_URL="http://localhost:3000"
# Producción: true. Desarrollo/staging: false o sin definir. Requiere recompilar.
PUBLIC_REGISTRATION_ONLY=false

# Firebase Authentication (configuracion Web, publica). Produccion las inyecta
# scripts/cloudflare-build.ts; en local se apunta al proyecto que se quiera usar.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
