{
  "name": "bebras-contest",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"bun run --cwd backend dev\" \"bun run --cwd frontend dev\"",
    "setup": "bun install && bun install --cwd backend && bun install --cwd frontend",
    "env:setup": "bun ./scripts/setup-env.ts",
    "db:generate": "bun run --cwd backend prisma:generate",
    "db:push": "bun run --cwd backend prisma:push",
    "db:seed": "bun run --cwd backend db:seed",
    "db:tasks": "bun run --cwd backend db:tasks",
    "db:tasks:replace": "bun run --cwd backend db:tasks:replace",
    "db:admins": "bun run --cwd backend db:admins",
    "db:schools:fetch": "bun run --cwd backend db:schools:fetch",
    "db:clear-teams": "bun run --cwd backend db:clear-teams",
    "db:setup": "bun run db:generate && bun run db:push && bun run db:seed && bun run db:tasks && bun run db:admins",
    "test:unidad": "bun x tsx --test tests/*.unit.ts tests/*.test.ts backend/prisma/*.test.ts backend/src/lib/*.test.ts backend/src/lib/task-answers/*.test.ts",
    "test:e2e": "bun ./tests/run-e2e.ts",
    "test:e2e:rapido": "bun ./tests/run-e2e.ts --rapido",
    "test:e2e:servidores": "bun ./tests/run-e2e.ts --servidores",
    "test:e2e:tareas": "bun ./tests/run-e2e.ts --project=tareas",
    "test:e2e:desafios": "bun ./tests/run-e2e.ts --project=desafios",
    "test:e2e:grupos": "bun ./tests/run-e2e.ts --project=grupos",
    "test:e2e:juego": "bun ./tests/run-e2e.ts --project=juego",
    "test:e2e:practica": "bun ./tests/run-e2e.ts --project=practica",
    "test:e2e:cuentas": "bun ./tests/run-e2e.ts --project=cuentas",
    "test:e2e:interfaz": "bun ./tests/run-e2e.ts --project=interfaz",
    "test:e2e:list": "bun x playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.1",
    "exceljs": "^4.4.0"
  }
}
